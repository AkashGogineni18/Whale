{
  "expo": {
    "name": "Whale",
    "slug": "whale-app",
    "scheme": "whale",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.whale.mobile"
    },
    "android": {
      "package": "app.whale.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-video",
      "expo-splash-screen",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "79c7d478-71c2-4eeb-afe0-5cfeffaf2a07"
      }
    },
    "owner": "akashgogineni",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/79c7d478-71c2-4eeb-afe0-5cfeffaf2a07",
      "checkAutomatically": "NEVER"
    }
  }
}
